# Copy to .env next to compose.yaml.

# The repository the runners register to.
REPO_URL=https://github.com/OWNER/REPO

# Only for the first `docker compose up`. Valid for one hour, registers every runner:
#   gh api -X POST repos/OWNER/REPO/actions/runners/registration-token --jq .token
# Empty it again once all runners show as Idle under Settings > Actions > Runners.
RUNNER_TOKEN=
